# Copy to .env and replace both passwords before starting the stack.
POSTGRES_DB=anomalies
POSTGRES_USER=anomalies
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_HOST=localhost
DATABASE_URL=
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_ANOMALY_MODEL_NAME=log-anomaly-detector
ANOMALY_API_PORT=8001
LOGSTASH_CONFIG_TOKEN=replace-with-a-long-random-token
LOGSTASH_CONFIG_API_PORT=8002
ELASTICSEARCH_LOGS_API_PORT=8003
CONTAINER_LOGS_HOST_PATH=./container-logs
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-another-long-random-password

# Image versions are pinned to releases; update together for Elastic components.
ELASTIC_VERSION=9.5.5
POSTGRES_VERSION=18.3
PROMETHEUS_VERSION=v3.15.1
ALERTMANAGER_VERSION=v0.34.2
GRAFANA_VERSION=12.3.1

ES_JAVA_OPTS=-Xms1g -Xmx1g
LS_JAVA_OPTS=-Xms512m -Xmx512m
PROMETHEUS_RETENTION=15d

# Optional host port overrides
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
KIBANA_VISUALIZATIONS_API_PORT=8004
KIBANA_SPACE=default
KIBANA_API_KEY=
KIBANA_USERNAME=
KIBANA_PASSWORD=
KIBANA_REQUEST_TIMEOUT_SECONDS=10
LOGSTASH_BEATS_PORT=5044
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
